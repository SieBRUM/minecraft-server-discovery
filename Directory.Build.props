<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1848/CA1873: LoggerMessage source generators are overkill for a research tool. -->
    <!-- CA1515: public types in an exe are fine here. CA2007: no SynchronizationContext in these apps. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1515;CA2007;CA1812</NoWarn>
    <Authors>SieBRUM</Authors>
    <Product>Minecraft Server Discovery</Product>
    <Copyright>Copyright (c) SieBRUM and contributors. Licensed under the Apache License 2.0.</Copyright>
  </PropertyGroup>
</Project>
